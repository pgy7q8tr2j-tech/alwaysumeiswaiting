# ===== 第二の脳 MCP =====

# Neon Postgres 接続文字列
# (Neon dashboard → Project → Connection Details → Connection string)
DATABASE_URL=postgresql://username:password@xxx.neon.tech/neondb?sslmode=require

# MCP エンドポイント認証トークン（推測しにくい値を設定）
# 生成例: openssl rand -hex 32
MCP_SECRET_TOKEN=your-secret-token-here

# ===== 既存アプリ (Stripe) =====

STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_BOOKING_DEPOSIT_PRICE_ID=price_...
